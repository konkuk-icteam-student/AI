# Production-only PostgreSQL; do not reuse the staging database or its credentials.
POSTGRES_DB=chatbot_prod
POSTGRES_USER=chatbot_prod
# Generate a unique strong password; never commit your server's .env.
POSTGRES_PASSWORD=
# URL must use the same password as POSTGRES_PASSWORD and hostname postgres.
# Example: 'postgresql://chatbot_prod:<PASSWORD>@postgres:5432/chatbot_prod'
DATABASE_URL=
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
# Use an Ollama URL reachable FROM THE API CONTAINER (not container loopback).
OLLAMA_BASE_URL=
EMBEDDING_MODEL=qwen3-embedding:0.6b
LLM_MODEL=qwen3:8b
